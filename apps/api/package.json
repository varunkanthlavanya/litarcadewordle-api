{
  "name": "@litarcadewordle/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "node-pg-migrate up -j ts --migrations-dir src/db/migrations --tsconfig tsconfig.json",
    "migrate:down": "node-pg-migrate down -j ts --migrations-dir src/db/migrations --tsconfig tsconfig.json",
    "migrate:create": "node-pg-migrate create -j ts --migrations-dir src/db/migrations",
    "check:words": "tsx scripts/import-word-corpus.ts"
  },
  "dependencies": {
    "@litarcadewordle/shared-types": "0.1.0",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
